run locally" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;" vertex="1" parent="1">
          <mxGeometry x="300" y="770" width="130" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="diagnose" value="/diagnose
reproduce→minimise→hypothesise
→instrument→fix→regression-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontColor=#3730a3;" vertex="1" parent="1">
