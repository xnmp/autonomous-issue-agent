# Autonomous issue agent — configuration (full knob reference).
#
# MULTI-REPO LAYOUT (preferred): put repo-independent knobs (identity, Jira,
# models, budgets) in config/shared.env and per-repo knobs (REPO, TARGET_DIR,
# BASE_BRANCH, state dirs) in config/repos/<name>.env, then:
#     make point-at REPO=<name>          # bin/point-at.sh composes them → .active.env
# SINGLE-REPO LAYOUT (legacy): copy this file to config/agent.env and edit; all
# scripts source it via lib.sh. Every value can be overridden by the real env.

# ── Required ───────────────────────────────────────────────────────────────
REPO="owner/repo"                 # the target repository (gh form: owner/name)
BASE_BRANCH="dev"                 # everything targets this; prod promotion is human
# Local path to the target repo's working copy. The watchers MUST run with cwd
# here (git/worktree ops are cwd-relative); lib.sh cd's to it. Required for
# launchd/systemd service mode (units have no reliable working dir). Leave blank
# only if you start the watchers from inside the target repo yourself.
TARGET_DIR=""                     # e.g. /Users/you/Repos/your-repo

# ── Identities ───────────────────────────────────────────────────────────────
# IDENTITY_MODE=three  → fix-bot ≠ review-bot ≠ steward-bot (full design).
# IDENTITY_MODE=solo   → one account; the review step is skipped (human reviews),
#                        self-approval is never attempted (avoids GitHub 422).
IDENTITY_MODE="three"
FIX_BOT="fix-bot"                 # login of the fixer identity
REVIEW_BOT="review-bot"           # login of the reviewer identity (three-mode)
STEWARD_BOT="steward-bot"         # login of the steward identity (three-mode)

# Per-identity gh auth. If set, scripts run gh as `gh --hostname ... ` using the
# token in this var. Leave blank to use the ambient `gh auth` login (fine for
# solo mode or a single-account test).
FIX_BOT_TOKEN=""
REVIEW_BOT_TOKEN=""
STEWARD_BOT_TOKEN=""

# ── Claude invocation ────────────────────────────────────────────────────────
# Permission mode for headless agents. `auto` lets Claude self-approve routine
# tool calls and only surfaces genuinely risky ones — in a headless daemon those
# become a status=blocked → GitHub comment → human reply → resume cycle.
# Other valid modes: default, acceptEdits, dontAsk, bypassPermissions.
PERMISSION_MODE="auto"

MAX_BUDGET_USD="10.00"            # per fix session
REVIEW_BUDGET_USD="8.00"          # per review
STEWARD_BUDGET_USD="3.00"         # per steward turn
ADVERSARIAL_BUDGET_USD="0.75"     # pre-PR adversarial subagent (hook-variant only)

# ── Spend circuit breakers ───────────────────────────────────────────────────
# The budgets above bound ONE session; nothing bounded the AGGREGATE, so a leg
# that retries without converging spent without limit while every individual run
# stayed politely under budget. These two caps close that hole, using the cost
# ledger the daemons append to (`$XDG_STATE_HOME/issue-agent/spend.jsonl`, shared
# by every repo and role on this machine). Set either to 0 to disable it.
#
# ISSUE_SPEND_CAP_USD — LIFETIME spend on one issue, across every leg (resolve,
# resume, review, address-review, CI fix, rebase) and every day. Hitting it is
# treated as a circuit breaker like any other: the issue is commented and moved
# ai-working → needs-human-review, which takes it out of the pickable set for
# good. Lifetime rather than daily on purpose — the cap exists to stop one issue
# grinding forever, and a daily window would forgive exactly that at midnight.
ISSUE_SPEND_CAP_USD="25.00"
# DAILY_SPEND_CAP_USD — today's spend across ALL repos and roles (UTC day).
# Hitting it pauses dispatch and changes NO labels: the condition is level-
# triggered, not an event, and it heals by itself at 00:00 UTC. Marking each
# blocked issue needs-human-review would leave you unwinding a dozen labels in
# the morning for a problem that fixed itself. The daemons keep polling and
# re-evaluate each tick; no agent is started, so the churn is free.
DAILY_SPEND_CAP_USD="50.00"
# ALERT_CMD — shell command run (via `sh -c`) with the event JSON on stdin for
# every spend block and every escalation to needs-human-review. These are the
# only two states that need a human, so they are the only two that page. Blank =
# no alerting; the events are journalled either way (see the per-role
# `<STATE_DIR>/journal.jsonl`, summarised by `issue-agent status`).
#   e.g. ALERT_CMD='jq -r ".event" | xargs -I{} notify-send "harness: {}"'
ALERT_CMD=""

# Optional: force a specific model per role (blank = account default).
# Setting FIX_MODEL bypasses the difficulty router below (explicit override wins).
FIX_MODEL=""

# Base reasoning effort for the FIX legs: low | medium | high (blank = leave each
# runtime on its own default — CODEX_REASONING_EFFORT below for codex, the SDK's
# own for Claude). Runtime-agnostic: the harness renders it per runtime.
FIX_EFFORT=""

# Escalate one rung when the harness already has evidence the previous attempt
# under-delivered — a `recurrence` label (an issue the harness "fixed" that came
# back), a failed resolve retry, or a second-and-later CHANGES_REQUESTED review
# outstanding on the PR (an APPROVE clears the count).
# Effort climbs first (same model, more thinking), tier second. Every step is
# journalled as a `route_escalation` event so $/merge stays splittable by tier.
# 0 pins every leg to the difficulty router's verdict no matter what happened
# before.
ESCALATE_ON_EVIDENCE="1"
REVIEW_MODEL="opus"               # a DIFFERENT (and strong) model decorrelates blind spots;
                                  # opus recommended — the reviewer is the last gate before merge.
                                  # If your gateway rejects full model ids, use the bare alias.
STEWARD_MODEL=""

# Reviewer strategy. single (default) | multi | delegated.
#   single    — one session-resumed agent reads the diff + files itself.
#   multi     — the /code-review fan-out: cheap skip-gate → parallel dimension
#               specialists (correctness/test-integrity/security/architecture) →
#               per-finding adversarial validation → pure synthesis. Gate +
#               validators run on REVIEW_GATE_MODEL / REVIEW_VALIDATION_MODEL
#               (haiku), specialists on REVIEW_MODEL.
#   delegated — single-pass reviewer (REVIEW_MODEL, e.g. opus) PLUS a cheap
#               code-scout subagent it delegates codebase search to, so the
#               expensive model reasons over compressed summaries instead of
#               spending opus tokens reading raw files. Augment mode: the reviewer
#               keeps its own Read tools, the scout is an optimisation it may lean on.
REVIEW_MODE="single"
REVIEW_SCOUT_MODEL="sonnet"       # delegated mode: the code-scout subagent's model
                                  # (cheaper than REVIEW_MODEL). sonnet recommended.
# Legacy alias: REVIEW_MULTI_AGENT=1 is still honoured, == REVIEW_MODE=multi.
# REVIEW_MULTI_AGENT="0"
# multi-mode sub-model / budget knobs (defaults shown):
# REVIEW_GATE_MODEL="haiku"; REVIEW_VALIDATION_MODEL="haiku"
# REVIEW_GATE_BUDGET_USD="0.10"; REVIEW_DIMENSION_BUDGET_USD="0.75"; REVIEW_VALIDATION_BUDGET_USD="0.20"

# Difficulty router (resolve-issue.sh, cold start): a cheap Haiku call classifies
# each issue and picks the MAIN model. Blank = use the env's ANTHROPIC_DEFAULT_*
# model ids (else bare aliases haiku/sonnet/opus). Override a tier here if desired.
ROUTE_TRIVIAL_MODEL=""            # blank → ANTHROPIC_DEFAULT_HAIKU_MODEL / haiku
ROUTE_STANDARD_MODEL=""           # blank → ANTHROPIC_DEFAULT_SONNET_MODEL / sonnet
ROUTE_COMPLEX_MODEL=""            # blank → ANTHROPIC_DEFAULT_OPUS_MODEL / opus
FIX_SUBAGENT_MODEL=""             # model for delegated exploration; blank → haiku
ROUTE_DEFAULT_MODEL=""            # router-failure fallback tier; blank → sonnet
ROUTER_MODEL=""                   # model for the cheap classify call; blank → haiku

# ── Merge policy ─────────────────────────────────────────────────────────────
# AUTO_MERGE=1 → on APPROVE + green CI, enable GitHub auto-merge into BASE_BRANCH.
# AUTO_MERGE=0 → stop at approved+green; a human clicks merge.
# NOTE: `gh pr merge --auto` requires the REPO to permit auto-merge. point-at.sh
# enables it on the target by default (ENSURE_AUTO_MERGE=1); without it an approved
# PR loops "Auto merge is not allowed for this repository".
AUTO_MERGE="1"
MERGE_METHOD="squash"             # squash | merge | rebase
# AUTO_REBASE_CONFLICTS=1 (default): when an open PR goes CONFLICTING (its base
# advanced after it opened — another PR merged touching the same files), wake the
# fixer to rebase the branch onto BASE_BRANCH, resolve conflicts, and push. The
# backup plan for a conflict that slips past the pre-dispatch file-overlap gate.
# Bounded by MAX_REBASE_RETRIES → then needs-human-review. Set 0 to escalate to a
# human on the first conflict instead of auto-rebasing.
AUTO_REBASE_CONFLICTS="1"
MAX_REBASE_RETRIES="3"
# CLOSE_ISSUE_ON_MERGE=1 (default): cleanup.sh closes the linked issue itself on
# merge. GitHub auto-closes an issue ONLY when the PR merges into the DEFAULT
# branch; since we target BASE_BRANCH (dev), the closing-keyword reference never
# fires and the issue would sit OPEN+ai-done forever. Set 0 to leave it open
# (e.g. if a human verifies on dev before closing).
CLOSE_ISSUE_ON_MERGE="1"

# ── Loop tuning ──────────────────────────────────────────────────────────────
POLL_SECONDS="20"
# Change-probe gate on the review/steward world builds: each quiet tick costs 1
# REST point ("did any issue/PR update?") instead of ~14 GraphQL points for a
# full build (the 2026-07-26 rate-limit exhaustion: review+steward sharing one
# token at 20s polls). The fix daemon is NEVER probed — it reacts to CI check
# states and mergeability, which change without bumping any updated_at. The TTL
# forces a full reconciliation build at least this often regardless.
WORLD_PROBE="1"
WORLD_PROBE_TTL_SECONDS="300"
# Arm auto-merge at PR CREATION when (and only when) the base branch's
# protection verifiably requires ≥1 approving review AND ≥1 status check — the
# gate then lives server-side and GitHub merges the instant review+CI land,
# with no daemon on the critical path (a busy fixer otherwise delays merges by
# up to a whole resolve session). "auto" probes at fix-daemon boot; "0" never
# arms early. There is deliberately no "1": forcing it without the verified
# gate would merge unreviewed work.
ARM_ON_OPEN="auto"
MAX_CI_RETRIES="3"
# Ext-regex of CI check NAMES to EXCLUDE from CI-state decisions (ci_state /
# auto-merge). For checks that are environmentally stuck — e.g. jobs that queue
# forever on starved runners and never start — and would otherwise pin ci_state
# at `pending` and deadlock both fix-CI and auto-merge. Excluded checks are
# ignored; all OTHER checks still count (a real failure is never masked).
# Blank = ignore nothing. Example: "Format Backend|Frontend Unit Tests".
CI_IGNORE_CHECKS=""
# Conditional CI-fix MCP servers, attached to the fixer ONLY when the PR's CI
# actually contains a matching check (keeps the harness target-agnostic). JSON map
# keyed by a check-name ext-regex; each value: {config: <mcp-json path>, tools:
# <tool glob to allow-list>}. Paths resolve from the harness root; the config file
# holds the server def + its secrets so keep it gitignored (see config/mcp/).
# Blank = none (default; the fixer diagnoses purely from the Actions log). Example:
#   FIX_MCP_CONFIG='{"SonarQube":{"config":"config/mcp/sonarqube.json","tools":"mcp__sonarqube__*"}}'
FIX_MCP_CONFIG=""
# Escalate to a human after this many reviewer REQUEST_CHANGES verdicts on one PR.
# Counts the reviewer's OWN rejections, NOT author pushes — a rebase or a post-
# approval housekeeping push that never drew a rejection does not consume a round.
# Default 4: rejections 1-3 bounce back to the fixer, the 4th escalates.
REVIEW_MAX_REJECTIONS="4"
MAX_REVIEW_RETRIES="3"            # failed address-review attempts on one PR before
                                  # the circuit breaker escalates it to needs-human-review
# Resolve breaker (T3 finding): every other paid leg had a retry ceiling; resolve
# — the most expensive leg — had none, so an always-erroring resolve requeued
# ai-ready and re-dispatched a full paid session every poll, forever.
MAX_RESOLVE_RETRIES="3"
# Infra-death ceiling (review C3): a pre-result session death (transport drop,
# daemon restart/OOM between dispatch and the workflow tail persisting state) is
# NOT counted as a retry attempt by the breakers above — the crash-isolation
# contract deliberately keeps "died before answering" separate from "answered
# wrong". Without a separate ceiling that made it unbounded, unbilled, and
# invisible: one full paid session every poll, forever, with nothing tripping.
# This bounds how many times ONE issue may die before escalating to a human.
# 0 disables.
MAX_INFRA_DEATHS="5"
# Reviewer twin of MAX_INFRA_DEATHS: paid review rounds that advanced NOTHING —
# a session that died, a multi-agent fan-out whose synthesis returned None, a
# failed submit POST, an errored skip-gate. At the cap the PR escalates to
# needs-human-review instead of buying another round. 0 disables.
MAX_UNPRODUCTIVE_REVIEW_ROUNDS="5"
# The PR label the reviewer triggers on. Default `ai-pr-open` = the harness's own
# pipeline PRs. To point the SAME review daemon at an EXTERNAL repo (PRs not produced
# by this harness — e.g. human-authored ones), run a SECOND `review` process with its
# own env file: set REPO=<owner/external-repo>, REVIEW_TRIGGER_LABEL=ai-review (a human
# tags the PR with `ai-review` to request a bot review), a separate REVIEW_STATE_DIR
# (so its per-PR session state doesn't collide), and a lenient REVIEW_PROMPT (the
# default reviewer expects harness TDD/acceptance-criteria/evidence conventions and
# would REQUEST_CHANGES on a normal PR). Reuses the same GitHub App identity (GH_APP_*),
# so it reviews as <app>[bot] — distinct from the human author, satisfying
# no-self-approval. The App must be INSTALLED on that repo with write access. Create
# the trigger + `needs-human-review` labels in the target repo first.
REVIEW_TRIGGER_LABEL="ai-pr-open"
# Rogue-PR adoption: 1 (default) → the reviewer also picks up OPEN PRs that carry
# no trigger label (opened directly, never via an issue) and labels them so they
# enter the normal review flow — closing the gap where such a PR is reviewed by
# nobody. Drafts, the review bot's OWN PRs, and PRs labelled `no-ai-review` are
# never adopted. Set 0 to only review explicitly-labelled PRs.
REVIEW_ADOPT_UNLABELED="1"
RESUME_FORK_THRESHOLD="5"         # fork the session after this many resumes
REVIEWER_RUNS_TESTS="0"           # 1 → reviewer checks out + runs TEST_CMD
STEWARD_SLEEP_SECONDS="3600"
# AUTHOR_TESTS_SPLIT=1 → resolve each issue in TWO blind passes sharing one
# worktree: a test/interface AUTHOR (writes interfaces + failing tests, no
# implementation, opens no PR) then a fresh-session IMPLEMENTER (makes the tests
# green and opens the PR). Structural context asymmetry: the author can't tailor
# tests to an implementation it never sees, and the implementer can't weaken the
# tests (the PR gate's test-immutability + red-must-fail checks enforce it). Costs
# a second cold session per issue. Default 0 (single-pass resolve).
AUTHOR_TESTS_SPLIT="0"
# Contract escape hatch (split mode only): if the implementer finds a test/criterion
# GENUINELY wrong it returns status=contract_change; the worktree is reset and a
# FRESH author adjudicates the objection (blind to the implementer's code) — revising
# the contract or upholding it. MAX_CONTRACT_ROUNDS bounds these petition→adjudicate
# rounds before the dispute escalates to a human (needs-human-review). Default 2.
MAX_CONTRACT_ROUNDS="2"

# ── Requirements triage (steward vets issues before the fixer) ───────────────
# STEWARD_TRIAGE=1 → each turn the steward triages every UNTRIAGED open issue
# (one with no lifecycle label yet — a user need not apply any tag). It drafts
# testable acceptance criteria when missing, and ONLY when a gap genuinely blocks
# implementation it @-mentions the issue creator for the missing detail and adds
# `ai-triage` (= seen, awaiting author). An author reply re-triages automatically.
# Default 1 (on): the steward vets untriaged issues by default. Pair with
# STEWARD_PROMOTE=0 (below) so it posts AC / asks for gaps but a human still moves
# an issue to ai-ready — triage informs, a human opens the fixer's front door.
STEWARD_TRIAGE="1"
# STEWARD_PROMOTE=1 → a vetted-READY issue is promoted by the steward itself
# (ai-triage→ai-ready, fully autonomous front door). =0 (default) → the steward
# only posts the AC and tags `ai-triage`; a human moves it to ai-ready.
STEWARD_PROMOTE="0"
# Triage READS repo files to draft grounded acceptance criteria; $0.75 can abort
# mid-exploration (error_max_budget_usd) on a thin issue and silently re-loop.
# Give it headroom on codebases that need real exploration.
STEWARD_TRIAGE_BUDGET_USD="2.00"  # per-issue triage classify + light code read
# Who to @-mention for OWNER-level triage questions (technical/architectural calls
# a maintainer must make — e.g. "add a User to the domain model" — NOT put to a
# possibly-non-technical issue author). Resolution order: the target repo's
# CODEOWNERS `*` default owners → this STEWARD_OWNER → none (logged, never silent).
# A user (@alice) or a team (@org/maintainers).
STEWARD_OWNER=""
TRIAGE_LABEL="ai-triage"          # the steward's "seen / awaiting author" marker
# Triage is shallow-read + classification, not a frontier-model task — run it on a
# cheaper model than the main steward pass. Blank → STEWARD_MODEL if set, else the
# bare alias `sonnet`. If your gateway rejects full model ids, use the bare alias.
STEWARD_TRIAGE_MODEL="sonnet"

# ── Jira sync (steward mirrors GitHub issues into Jira tickets) ──────────────
# JIRA_SYNC=1 (default): the steward creates a Jira ticket for each GitHub issue
# once it gets its first lifecycle label, and transitions the ticket's status as the
# GitHub label moves (ai-ready/ai-triage→To Do, ai-working/ai-pr-open/ai-blocked→In
# Progress, ai-done→Done). One ticket per issue; the issue→ticket-key map is kept in
# STATE_DIR. It reaches Jira through the Atlassian MCP (see JIRA_MCP_CONFIG), attached
# only to the steward. Sync is INERT until JIRA_PROJECT_KEY is set, so the default-on
# flag is harmless on a repo with no Jira project. A Jira/auth error is logged and the
# steward continues (fail-soft, retried next poll). Set 0 to disable entirely.
JIRA_SYNC="1"
JIRA_PROJECT_KEY=""               # e.g. "ABC" — REQUIRED to actually create tickets
JIRA_CLOUD_ID=""                  # Jira site cloudId or host (e.g. yoursite.atlassian.net);
                                  # blank → the MCP resolves the only accessible site
# PREREQUISITE: the Atlassian MCP is OAuth (interactive). One-time, on the SAME
# machine/user the steward runs as:
#   claude mcp add --transport http atlassian https://mcp.atlassian.com/v1/mcp --scope user
# then launch claude once and complete the browser login (token is cached + reused).
# Also add mcp.atlassian.com to no_proxy/NO_PROXY in your shell rc. Without this, the
# sync leg logs an auth error each poll and no-ops (the daemon stays up).
# JIRA_MCP_CONFIG points at an MCP spec file ({"mcpServers":{"atlassian":{...}}}); the
# default below carries NO secret (the OAuth token is cached by claude separately), so
# although config/mcp/ is gitignored you can commit this one. Example contents:
#   {"mcpServers":{"atlassian":{"type":"http","url":"https://mcp.atlassian.com/v1/mcp",
#     "env":{"NODE_EXTRA_CA_CERTS":"/path/to/ca_bundle.pem"}}}}
JIRA_MCP_CONFIG="config/mcp/atlassian.json"
JIRA_MCP_TOOLS="mcp__atlassian__*"
JIRA_SYNC_BUDGET_USD="0.50"       # per create/transition agent run

# ── Project commands (the agent + hooks use these; set per target repo) ──────
LINT_CMD=""                       # e.g. "ruff check ." — runs in commit hook
TYPECHECK_CMD=""                  # e.g. "mypy src"     — runs in commit hook
TEST_CMD=""                       # e.g. "pytest -q"    — runs in PR gate + reviewer  # MUST be non-watch (e.g. 'vitest run', NOT 'vitest'); watch mode hangs the gate hook.
# ALLOW_UNTESTED=1: the ONLY way to run a genuinely test-less repo without the
# gate denying every PR/push. With no TEST_CMD resolvable (neither this nor a
# `.harness/test-cmd` the agent wrote), the tests gate AND the red-must-fail
# check now fail CLOSED by default — an empty test command used to pass
# through silently, which is indistinguishable from "the repo has no tests"
# vs. "the operator forgot to set TEST_CMD". This is an OPERATOR OVERLAY FACT
# (a claim about the repo, not a task outcome) — the agent never sets it.
# `issue-agent start` auto-writes it into the repo overlay when its test-command
# discovery genuinely finds none (behind the loud "THIS REPO HAS NO TESTS"
# banner). Blank/0 = fail closed on no TEST_CMD (default, safe).
ALLOW_UNTESTED=""
# GATE_TEST_TIMEOUT_S: hard ceiling (seconds) on any TEST_CMD invocation the
# gate itself runs (PR-create §1, push-gate re-check, the red-must-fail
# revert-and-rerun). A run that exceeds it is killed and treated as a gate
# FAILURE (DENY) — a hung/runaway test command must not wedge the hook
# forever, but a timeout also must not silently read as "tests passed".
# Default 600 (10 min); raise for a genuinely slow suite.
GATE_TEST_TIMEOUT_S="600"
# GATE_GH_RETRY_SLEEP: seconds slept between the push gate's two `gh pr list`
# attempts (checks/check-push.sh) when deciding whether the pushed branch has
# an open PR. That lookup fails CLOSED (denies the push) if `gh` still errors
# after the retry — see constraint 29 / decision 13 in HARNESS.md. Default 2;
# lower only matters for driving this retry path fast in tests.
GATE_GH_RETRY_SLEEP="2"
# EDIT_CHECK_CMD: a fast, deterministic check run AFTER every file edit (the
# PostToolUse(Edit|Write) hook), so type errors surface to the agent immediately
# instead of at commit/CI. Must be quick (it runs per edit) — a typecheck or lint,
# NOT the test suite. Blank = no edit-time check (no behaviour change). Examples:
#   EDIT_CHECK_CMD="npx tsc --noEmit"      # TS/Svelte
#   EDIT_CHECK_CMD="pyrefly check"          # Python
# The hook runs in the EDIT's cwd, often NOT the repo root. A command that assumes a
# fixed path (e.g. `cd backend && ...`) throws when cwd has no backend/, so the check
# returns non-zero on EVERY edit and blocks the agent with a bogus reason (a tight
# block-loop that can wedge the session). Guard path assumptions and exit 0 on the
# "not applicable here" path:
#   EDIT_CHECK_CMD="test -d backend && (cd backend && uv run pyrefly check) || true"
# RED_MUST_FAIL=1 (default): at PR-create the gate reverts the implementation, keeps
# the NEW test files, and re-runs TEST_CMD — the new tests MUST then fail. This
# catches tautological / wrong-layer tests (a test green without the change). Needs
# TEST_CMD set. Set RED_MUST_FAIL=0 to disable (e.g. a suite too slow to run twice).
RED_MUST_FAIL="1"
# VERIFY_RED_AT_COMMIT=1 (default): when the agent makes a `red:` commit, run TEST_CMD
# on the working tree right then and require it to FAIL — in-session fail-fast that the
# committed test is genuinely red (RED_MUST_FAIL above is the committed-state backstop
# at PR time, which also catches a test weakened after the red commit). Needs TEST_CMD.
# Set 0 to disable (a suite too heavy to run inside a commit hook).
VERIFY_RED_AT_COMMIT="1"
METRICS_CMD=""                    # optional: emits one JSON line of drift metrics

# ── Fixer runtime ─────────────────────────────────────────────────────────────
# Which engine drives the FIX leg (reviewer/steward always stay Claude — a
# distinct model decorrelates blind spots). "claude" = Claude Agent SDK (query()
# control-stream); "codex" = OpenAI Codex CLI (an OpenAI-compatible model;
#   governor installed as a Codex filesystem hook, no SDK control-stream).
#   REQUIRES for codex: `codex` on PATH AND the gateway key (CODEX_ENV_KEY, default
#   OPENAI_API_KEY) exported in the launching shell — the daemons inherit it;
#   nothing is hardcoded. Without the key the Codex runtime cannot authenticate.
#   Codex follows OpenAI conventions (OPENAI_API_KEY + OPENAI_BASE_URL); point both
#   at your OpenAI-compatible endpoint. Behind a proxy you typically alias the key
#   and set OPENAI_BASE_URL to the gateway in shared.env.
#   "glm" = GLM (e.g. GLM-5.2) via Z.ai's ANTHROPIC-COMPATIBLE endpoint. Same wire
#   protocol as Claude, so this is the same SDK runner with a Claude Code PROFILE's
#   environment injected — see GLM_SETTINGS_FILE below.
FIXER_RUNTIME="claude"            # claude | codex | glm  (set in shared.env)
# ── FIXER_RUNTIME=glm ────────────────────────────────────────────────────────
# Path to the profile's settings.json; its PARENT DIRECTORY is the profile dir.
# REQUIRED when FIXER_RUNTIME=glm (blank is a config error). Read once at daemon
# startup; a missing/malformed file logs "glm: NOT READY at startup — …" and the
# fixer falls back to plain Claude rather than dying.
#
# What the harness injects into the fixer's agent process (nothing else):
#   * every str→str pair in the settings.json `env` block — ANTHROPIC_BASE_URL,
#     the ANTHROPIC_DEFAULT_{OPUS,SONNET,HAIKU}_MODEL aliases, API_TIMEOUT_MS, …
#   * CLAUDE_CONFIG_DIR=<profile dir>, so the profile's own state is used
#   * ANTHROPIC_AUTH_TOKEN=<ZAI_API_KEY from the profile dir's .env>, if present
#     (parsed as plain KEY=VALUE lines — never sourced by a shell). Omit the .env
#     and export ANTHROPIC_AUTH_TOKEN in the launching shell instead if you prefer.
#   * ANTHROPIC_API_KEY="" — BLANKED ON PURPOSE. SDK options.env merges onto the
#     inherited environment, so an unset key would survive and let the CLI fall
#     back to Anthropic credentials, billing a real Anthropic account for a run
#     configured as GLM. A per-task env (TEST_CMD etc.) still wins over all of it.
#
# The profile's HOOKS AND PLUGINS DO NOT LOAD: daemon sessions run with
# setting_sources=["project"], so settings.json is never read by the CLI (the
# harness lifts only its env block). That is intended — an interactive profile's
# status-line/terminal hooks have no place in a headless daemon.
#
# Spend accounting: like codex, THE LEDGERED DOLLARS ARE FICTIONAL for glm runs —
# the SDK prices whatever Anthropic alias the model id resolves to, and no Z.ai
# invoice will match. They still bound TOKEN VOLUME, so ISSUE_SPEND_CAP_USD /
# DAILY_SPEND_CAP_USD remain real ceilings; read the numbers as a token meter.
GLM_SETTINGS_FILE=""              # e.g. ~/.cc-glm/settings.json
# ── FIXER_RUNTIME=codex ──────────────────────────────────────────────────────
CODEX_BIN="codex"
CODEX_MODEL=""                    # blank → CodexRunner default
CODEX_PROVIDER_ID="openai-custom"  # NOT "openai": codex-cli ≥0.142 reserves built-in IDs
CODEX_PROVIDER_NAME="OpenAI"
CODEX_BASE_URL=""                 # REQUIRED for codex: your OpenAI-compatible gateway
CODEX_ENV_KEY="OPENAI_API_KEY"
CODEX_WIRE_API="responses"
CODEX_SANDBOX="danger-full-access"
# Reasoning effort for every codex leg. codex exec's OWN default is low —
# too little thinking for an implementer; the harness pins medium unless told
# otherwise. Values per codex-cli: minimal|low|medium|high ("" = don't pin,
# keep codex's default).
CODEX_REASONING_EFFORT="medium"
# Idle watchdog (all runtimes): max seconds BETWEEN agent stream events before a
# run is deemed hung and aborted (retryable → issue back to ai-ready). NOT a total
# cap — a hard task streams events steadily and never trips it. The one legit long
# gap is a single long-running tool call (silent until it returns); the SDK Bash
# tool caps a foreground command at ~10 min, so 900 sits above that. MUST exceed
# the longest single tool invocation your repo runs — for an ML repo whose test is
# a training run, raise it or set 0 to disable. 0 disables.
AGENT_IDLE_TIMEOUT_SECONDS="900"
# Total-runtime ceiling — the cap the idle watchdog above CANNOT provide. A
# stream left "limping" by a suspend/resume (FAILURE-MODES #60) can emit an
# event just often enough to keep resetting the idle clock while making almost
# no real progress (observed: 58 wall-clock minutes on 3.6s of CPU). Bounds
# elapsed WALL time on any single agent session regardless of event cadence.
# Default 2700 (45 min). 0 disables.
AGENT_MAX_RUNTIME_SECONDS="2700"
# Largest single decoded SDK stream message (Claude path only). The SDK's own
# default is 1MB, and a tool result carries its payload base64'd (x4/3), so any
# Read of a file above ~750KB kills the transport for the WHOLE session — and
# deterministically, because the retry reads the same file (harness #13, a 2.3MB
# evidence PNG). 16MB survives a ~5MB read and costs nothing until a message
# needs it (the buffer bounds a decode; it is not preallocated).
# 0 = leave the SDK default in place.
SDK_MAX_BUFFER_BYTES="16777216"
# Codex-only gateway transport-drop retry. A `response.failed` / `stream
# disconnected before completion` from the LLM gateway is an UPSTREAM failure
# (codex's own in-connection reconnects don't recover it); a fresh `codex exec`
# gets a fresh connection, so the runner retries the whole invocation — RESUMING
# the session (codex persists only at turn boundaries, so a mid-stream drop never
# poisons resume) — with jittered exponential backoff (base * 2^n + up-to-50%
# jitter). Exhausting the retries surfaces a retryable timeout (daemon
# re-dispatches cold). Set retries=0 to disable the loop.
CODEX_TRANSPORT_RETRIES="4"
CODEX_BACKOFF_BASE_SECONDS="2"
# Codex spend accounting (review M1): codex runs are priced from the token
# usage on the envelope, in USD per MILLION tokens (matches provider pricing
# tables), input vs output separately since output tokens cost more.
#
# THE DEFAULT DOLLARS ARE FICTIONAL. They are gpt-5.6-sol's list price
# ($5 in / $30 out per MTok); on a ChatGPT subscription codex bills $0, so no
# invoice will ever match this number. They exist anyway because the QUOTA is
# real and exhaustible (a free-tier limit killed two runs on 2026-07-27), and a
# synthetic price is what lets ISSUE_SPEND_CAP_USD/DAILY_SPEND_CAP_USD bound
# codex TOKEN VOLUME — the caps fire on the same token count either way, they
# just report it in made-up dollars. Read the ledger's codex lines as a token
# meter, not a bill, and don't sum them with Claude spend expecting an invoice.
#
# Override with your gateway's real rates if you pay per token. Set BOTH to 0
# to opt out: codex spend then goes untracked and a loud startup warning fires
# whenever a spend cap is armed.
CODEX_COST_PER_MTOK_IN="5.00"
CODEX_COST_PER_MTOK_OUT="30.00"

# ── Misc ─────────────────────────────────────────────────────────────────────
HARNESS_REPO=""                   # where agents file harness bugs (blank = REPO)
# LOG_DIR: where point-at.sh writes each daemon's foreground-mode log file
# (<role>-<name>.log) and issue-agent's own tooling looks for them. Blank
# (default) → ${XDG_STATE_HOME:-~/.local/state}/issue-agent/logs. systemd units
# log to journald instead and ignore this.
LOG_DIR=""
# STATE_DIR / REVIEW_STATE_DIR / STEWARD_STATE_DIR (review M5): if left unset
# (or exported empty), from_env now defaults each to a PER-REPO path —
# ~/.local/state/issue-agent/<owner-name>, .../review-agent/<owner-name>,
# .../steward-agent/<owner-name> — so two repos' daemons can never share
# issue-N.session etc. and resume each other's transcript. Set explicitly (as
# below, or per-name via `issue-agent start`) to override; explicit values
# always win over the computed default.
STATE_DIR="$HOME/.local/state/issue-agent"
REVIEW_STATE_DIR="$HOME/.local/state/review-agent"
STEWARD_STATE_DIR="$HOME/.local/state/steward-agent"
WORKTREE_ROOT=".claude/worktrees"
# Hot reload: the daemons watch the harness repo's HEAD commit (commit-gated
# — a mid-edit save can never load a half-changed tree) plus the composed env
# file (gitignored; a single atomic operator save). A change restarts each
# daemon at its next BETWEEN-TICKS point (never mid-session — dispatch is
# synchronous inside a tick, so no paid agent work can be killed). point-at
# relaunches through `uv run`, so dependency changes ride along. "0" disables.
HOT_RELOAD="1"
