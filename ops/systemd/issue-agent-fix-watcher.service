# Linux systemd unit (user service) TEMPLATE — do not install by hand, the
# placeholder tokens below (wrapped in "at" signs) are filled in and this file
# is copied to ~/.config/systemd/user/issue-agent-fix-watcher-NAME.service by:
#   bin/install-systemd.sh
# Logs go to the journal — tail with:
#   journalctl --user -u issue-agent-fix-watcher-NAME -f
[Unit]
Description=Autonomous issue agent — fix watcher (@NAME@)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=all
ExecStart=@UV_BIN@ run --extra sdk --with tree-sitter --with tree-sitter-bash python -m issue_agent.app.main fix
WorkingDirectory=@HARNESS_ROOT@
Environment=AGENT_ENV=@CONFIG@
Environment=ISSUE_AGENT_DEPLOYMENT_ID=@DEPLOYMENT_ID@
Environment=TARGET_DIR=@TARGET_DIR@
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=0 2 3 4 5 6
TimeoutStopSec=90
WatchdogSec=300
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
MemoryMax=4G
# Chromium-based acceptance suites routinely use hundreds of threads. Keep
# enough headroom for the watcher and GitHub observations while MemoryMax
# remains the hard resource boundary.
TasksMax=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
