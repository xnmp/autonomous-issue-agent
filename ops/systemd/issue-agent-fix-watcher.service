# Linux systemd unit (user service) TEMPLATE — do not install by hand, the
# placeholder tokens below (wrapped in "at" signs) are filled in and this file
# is copied to ~/.config/systemd/user/issue-agent-fix-watcher-NAME.service by:
#   bin/install-systemd.sh
# Logs go to the journal — tail with:
#   journalctl --user -u issue-agent-fix-watcher-NAME -f
[Unit]
Description=Autonomous issue agent — fix watcher (@NAME@)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=all
ExecStart=@UV_BIN@ run --extra sdk python -m issue_agent.app.main fix
WorkingDirectory=@HARNESS_ROOT@
# Encrypted secrets (systemd-creds), filled in by bin/install-systemd.sh with
# one line per credential file present at install time; empty otherwise.
@CREDENTIALS@
Environment=AGENT_ENV=@CONFIG@
Environment=ISSUE_AGENT_DEPLOYMENT_ID=@DEPLOYMENT_ID@
Environment=TARGET_DIR=@TARGET_DIR@
# The operator's PATH, captured at install time: daemons spawn the target
# toolchain (codex via nvm, bunx, cargo/rustup shims) that a minimal systemd
# PATH cannot resolve — first systemd deployment 2026-08-10 killed every
# resolve leg at spawn (issue #650) until this. Re-run install-service after
# moving a toolchain (doctor's codex check names the drift).
Environment=PATH=@INSTALL_PATH@
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=0 2 3 4 5 6
# Exit 87 is the designed hot-reload path (harness source changed; daemon
# drains and asks to be restarted on new code). Without these lines every
# reload logs as 'Failed' and counts against StartLimitBurst — three commits
# inside 300s would permanently kill all units mid-batch (observed 2026-08-10:
# four units 'Failed' simultaneously on one commit's reload).
SuccessExitStatus=87
RestartForceExitStatus=87
TimeoutStopSec=90
WatchdogSec=300
KillSignal=SIGTERM
# uv forwards TERM to Python; signalling both would trigger forced shutdown.
KillMode=mixed
FinalKillSignal=SIGKILL
MemoryMax=4G
# Every thread counts as a task. Tauri legs (cargo/rustc plus Chromium or
# WebKit acceptance runs) exceeded 1024 twice on 2026-10-14 with concurrent
# legs, so the cap is 4096. MemoryMax stays the hard resource bound; this
# limit exists so a runaway leg (fork bomb, incident #63) cannot exhaust the
# user's pid space.
TasksMax=4096
StandardOutput=journal
StandardError=journal
# The manager can record a terminal result even when the daemon cannot flush;
# the hook runs in the unit's cgroup and adds its OOM counters.
ExecStopPost=-/bin/sh "@HARNESS_ROOT@/bin/service-terminal-evidence.sh"

[Install]
WantedBy=default.target
