{
  "name": "issue-agent-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "generate:api": "cd .. && UV_NO_CACHE=1 uv run --offline python scripts/export_dashboard_openapi.py && cd dashboard && openapi-typescript openapi.json -o src/api/generated.ts && openapi-zod-client openapi.json -o src/api/generated-zod.ts --export-schemas",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "^1.18.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
