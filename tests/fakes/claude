#!/usr/bin/env python3
"""Scriptable fake `claude` for orchestration tests.

Each invocation pops the next scripted response from a queue file
(env ISSUE_AGENT_FAKE_CLAUDE). A response is a JSON object:

  {
    "envelope": { ... },        # printed to stdout as the --output-format json result
    "effect": "open_pr" | "push" | "review:APPROVE" | "review:REQUEST_CHANGES"
                | "review:ESCALATE" | null,
    "for_issue": 5,             # used by open_pr to link the PR
    "rc": 0
  }

The "effect" mutates the fake-gh state file so GROUND TRUTH (pr_for_branch etc.)
reflects what a real agent would have done. This lets us test that the scripts
read ground truth, not prose.

If the queue is empty, returns a generic blocked envelope (so a runaway loop is
visible rather than hanging).
"""
import json
import os
import sys

QUEUE = os.environ["ISSUE_AGENT_FAKE_CLAUDE"]
GH_STATE = os.environ["ISSUE_AGENT_FAKE_STATE"]


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def save_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=2)
    os.replace(tmp, path)


def pop_response():
    q = load_json(QUEUE, [])
    if not q:
        return {
            "envelope": {
                "is_error": False, "subtype": "success", "session_id": "sess-empty",
                "total_cost_usd": 0.0,
                "structured_output": {"status": "blocked",
                                      "summary": "fake: no scripted response left",
                                      "needs": "scripted response"},
            },
            "effect": None, "rc": 0,
        }
    r = q.pop(0)
    save_json(QUEUE, q)
    return r


def apply_effect(r):
    effect = r.get("effect")
    if not effect:
        return
    s = load_json(GH_STATE, {"issues": {}, "prs": {}, "labels": [], "runs": {}})

    if effect == "open_pr":
        nums = [int(x) for x in s["prs"].keys()] or [99]
        n = str(max(nums) + 1)
        issue = r.get("for_issue")
        branch = r.get("branch", f"fix/{issue}-x")
        s["prs"][n] = {
            "number": int(n), "state": "OPEN",
            "title": r.get("title", f"Fix #{issue}"),
            "body": r.get("body", f"## Acceptance Criteria\n- ok\n\nFixes #{issue}"),
            "headRefName": branch,
            "headRefOid": r.get("sha", "sha-1"),
            "issue": issue, "labels": [], "reviews": [],
            "checks": r.get("checks", []),
            "diff": r.get("diff", "diff --git a/x b/x\n+x"),
            "inline_comments": [],
        }
        save_json(GH_STATE, s)

    elif effect == "push":
        # advance the head SHA of the PR linked to this issue/branch
        pr_n = r.get("pr")
        if pr_n and str(pr_n) in s["prs"]:
            pr = s["prs"][str(pr_n)]
            pr["headRefOid"] = r.get("sha", pr.get("headRefOid", "sha") + "x")
            if "checks" in r:
                pr["checks"] = r["checks"]
            save_json(GH_STATE, s)


def main():
    # Optionally record this invocation's argv (one JSON array per line) so tests
    # can assert which flags were passed (e.g. --model). Off unless the env var is set.
    arglog = os.environ.get("ISSUE_AGENT_FAKE_CLAUDE_ARGLOG")
    if arglog:
        with open(arglog, "a") as f:
            f.write(json.dumps(sys.argv[1:]) + "\n")
    r = pop_response()
    apply_effect(r)
    env = r.get("envelope", {})
    sys.stdout.write(json.dumps(env))
    sys.exit(r.get("rc", 0))


if __name__ == "__main__":
    main()
